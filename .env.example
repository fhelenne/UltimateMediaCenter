# Chemin du point de montage du disque USB externe sur l'hôte — utilisé
# uniquement par docker-compose.yml (driver_opts bind mount des volumes
# média), jamais lu par l'appli Python elle-même.
USB_MOUNT=/media/pi/external-disk
# Rempli automatiquement par install.sh — ne pas laisser vide en usage manuel
# (docker compose up échouerait avec un message peu clair : source de bind
# mount vide).
HOST_LIBRARY_ROOT=
# Rempli automatiquement par install.sh — ne pas laisser vide en usage manuel
SHARES_MOUNT=

NTFY_URL=http://ntfy:80
NTFY_TOPIC=mediacenter
SONARR_SECRET=changeme
RADARR_SECRET=changeme
LIDARR_SECRET=changeme
READARR_SECRET=changeme
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=changeme
RADARR_URL=http://radarr:7878
RADARR_API_KEY=changeme
LIDARR_URL=http://lidarr:8686
LIDARR_API_KEY=changeme
READARR_URL=http://readarr:8787
READARR_API_KEY=changeme
JELLYFIN_URL=http://jellyfin:8096
# Jellyfin ne peut pas être pré-configuré comme les *arr (pas de config.xml
# équivalent) : assistant de première configuration obligatoire via son
# interface web, où une clé API doit être générée manuellement puis collée
# ici, suivi d'un redémarrage de l'appli. install.sh ne peut pas automatiser
# cette étape — voir docs/superpowers/specs/2026-08-18-install-sh-design.md.
JELLYFIN_API_KEY=changeme
JELLYFIN_PUBLIC_URL=http://raspberrypi.local:8096
# Doit être une valeur aléatoire réelle : l'appli refuse de démarrer si
# SESSION_SECRET vaut "changeme" ou est vide.
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=changeme
CACHE_TTL=30
DB_PATH=data/cache.db
CALIBRE_LIBRARY_PATH=/books
